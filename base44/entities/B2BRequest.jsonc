{
  "name": "B2BRequest",
  "type": "object",
  "properties": {
    "reference_number": {
      "type": "string"
    },
    "agency_name": {
      "type": "string"
    },
    "contact_name": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "service": {
      "type": "string"
    },
    "offer": {
      "type": "string"
    },
    "destination": {
      "type": "string"
    },
    "travelers": {
      "type": "number"
    },
    "travel_date": {
      "type": "string",
      "format": "date"
    },
    "notes": {
      "type": "string"
    },
    "rc_file_uri": {
      "type": "string"
    },
    "rc_file_name": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "accepted",
        "rejected",
        "completed"
      ],
      "default": "pending"
    }
  },
  "required": [
    "agency_name",
    "contact_name",
    "phone"
  ],
  "rls": {
    "create": {},
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}