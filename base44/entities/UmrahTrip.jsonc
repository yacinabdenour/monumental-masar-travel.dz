{
  "name": "UmrahTrip",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "period": {
      "type": "string"
    },
    "image": {
      "type": "string"
    },
    "prices": {
      "type": "string"
    },
    "quint_limited": {
      "type": "boolean",
      "default": false
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "title",
    "period"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}