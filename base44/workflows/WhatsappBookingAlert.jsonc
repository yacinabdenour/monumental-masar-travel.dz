{
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "whatsapp_booking_alert",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "notify_whatsapp": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "sendWhatsappNotification",
            "args": {
              "reference_number": "${ .trigger.data.reference_number }",
              "agency_name": "${ .trigger.data.agency_name }",
              "contact_name": "${ .trigger.data.contact_name }",
              "phone": "${ .trigger.data.phone }",
              "email": "${ .trigger.data.email }",
              "service": "${ .trigger.data.service }",
              "offer": "${ .trigger.data.offer }",
              "destination": "${ .trigger.data.destination }",
              "travelers": "${ .trigger.data.travelers }",
              "travel_date": "${ .trigger.data.travel_date }",
              "notes": "${ .trigger.data.notes }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "\u0625\u0631\u0633\u0627\u0644 \u0625\u0634\u0639\u0627\u0631 \u0648\u0627\u062a\u0633\u0627\u0628",
            "description": "\u0631\u0633\u0627\u0644\u0629 \u0641\u0648\u0631\u064a\u0629 \u0625\u0644\u0649 \u0631\u0642\u0645 \u0635\u0627\u062d\u0628 \u0627\u0644\u0645\u0648\u0642\u0639"
          }
        }
      }
    ]
  },
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "B2BRequest"
    }
  },
  "name": "\u0625\u0634\u0639\u0627\u0631 \u0648\u0627\u062a\u0633\u0627\u0628 \u0644\u0637\u0644\u0628 \u062d\u062c\u0632 \u062c\u062f\u064a\u062f",
  "description": "\u064a\u0631\u0633\u0644 \u0631\u0633\u0627\u0644\u0629 \u0648\u0627\u062a\u0633\u0627\u0628 \u0641\u0648\u0631\u064a\u0629 \u0625\u0644\u0649 \u0635\u0627\u062d\u0628 \u0627\u0644\u0645\u0648\u0642\u0639 \u0639\u0646\u062f \u0625\u0646\u0634\u0627\u0621 \u0623\u064a \u0637\u0644\u0628 \u062d\u062c\u0632 \u0623\u0648 \u0637\u0644\u0628 \u0639\u0631\u0636 \u062c\u062f\u064a\u062f \u0645\u0646 \u0648\u0643\u0627\u0644\u0629"
}